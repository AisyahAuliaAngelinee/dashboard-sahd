# Publishable key only. Never put service-role/secret keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: false in production by default. Local development supports demo.
SAHD_ENABLE_DEMO=false
# Canonical public origin. Set on Vercel to your chosen personal domain.
SAHD_APP_URL=

# Server-only Gemini text. Use an AI Studio project on Free Tier.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Server-only: daily removal of files from permanently deleted reports.
# Set these in Vercel, never in NEXT_PUBLIC variables or source control.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
